# Salin ke .env lalu isi. Jangan commit .env.
# MariaDB eksternal (≥ 10.6), database WAJIB utf8mb4 (migrasi menolak bila bukan):
#   CREATE DATABASE app CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Pakai database khusus aplikasi, JANGAN database test:
# test suite mengosongkan database yang dipakainya. Nama database aplikasi jangan berakhiran _test.
# DB di host yang sama dengan Docker: pakai host.docker.internal + extra_hosts "host.docker.internal:host-gateway".
DATABASE_URL=mysql+asyncmy://ronda_app:GANTI_PASSWORD@db.example.internal:3306/ronda
# Worker butuh hak ALTER/DROP (partisi metrik & audit); wajib diisi untuk docker compose.
WORKER_DATABASE_URL=mysql+asyncmy://ronda_worker:GANTI_PASSWORD@db.example.internal:3306/ronda

# Wajib ≥ 32 karakter (aplikasi menolak start bila kurang):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# IP (atau subnet CIDR) Nginx Proxy Manager / reverse proxy TLS di depan Ronda, sebagaimana terlihat oleh nginx
# Ronda. Hanya dari alamat ini X-Forwarded-For & X-Forwarded-Proto dipercaya.
#   NPM di mesin lain:                IP mesin NPM, mis. 10.10.1.5
#   NPM container di host yang sama:  gateway network compose Ronda (mis. 172.30.0.1) atau IP host;
#                                     cek: docker compose logs nginx (alamat client di access log)
TRUSTED_PROXY=10.10.1.5

# Subnet network docker compose; juga satu-satunya sumber X-Forwarded-For yang dipercaya uvicorn.
# Ganti hanya bila bentrok dengan network lain di host.
APP_SUBNET=172.30.0.0/24

WEB_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# argon2 paralel per proses web; tiap hash ±64 MiB RAM
PASSWORD_HASH_CONCURRENCY=4

# Zona waktu tampilan (filter `localtime`); data di DB tetap UTC
DISPLAY_TIMEZONE=Asia/Jakarta

ORG_NAME=RS Contoh
HOME_PATH=/dashboard
# Session login: idle 30 menit, maksimal 12 jam sejak login
SESSION_TTL=1800
SESSION_MAX_AGE=43200

# Volume data (docker-compose: ronda-data)
SCREENSHOT_DIR=/srv/data/screenshots
RELEASE_DIR=/srv/data/releases

# Notifikasi alert (kosong = kanal jenis itu tidak mengirim)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_USER=
WHATSAPP_API_PASSWORD=

# Worker (addon jobs)
WORKER_CONCURRENCY=10
WORKER_SHUTDOWN_GRACE=25
WORKER_WATCHDOG_TIMEOUT=120

# Backup harian database (service `backup` di docker-compose). User DB khusus, hanya baca:
#   CREATE USER 'ronda_backup'@'%' IDENTIFIED BY '...';
#   GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON ronda.* TO 'ronda_backup'@'%';
BACKUP_DB_HOST=db.example.internal
BACKUP_DB_PORT=3306
BACKUP_DB_NAME=ronda
BACKUP_DB_USER=ronda_backup
# Ada karakter $ di password? Tulis dalam kutip tunggal: BACKUP_DB_PASSWORD='pa$sword'
BACKUP_DB_PASSWORD=GANTI_PASSWORD
# Folder backup di host; arahkan ke mount NAS (mis. /mnt/nas/ronda), jangan disk yang sama dengan database
BACKUP_PATH=./backups
# Jam backup (zona BACKUP_TZ, bawaan Asia/Jakarta) dan jumlah file yang disimpan (1 per hari → 7 hari)
BACKUP_TIME=02:00
BACKUP_KEEP=7
# metrics_hourly yang ikut di-backup (hari terakhir); 0 = tidak ikut
BACKUP_HOURLY_DAYS=31
# Pemilik file backup (uid:gid); ubah bila NAS NFS memakai root_squash
#BACKUP_UID_GID=1000:1000
