# Salin ke .env lalu isi. Jangan commit .env.
# MariaDB eksternal (≥ 10.6), database WAJIB utf8mb4 (migrasi menolak bila bukan):
#   CREATE DATABASE app CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Pakai database khusus aplikasi, JANGAN database test:
# test suite mengosongkan database yang dipakainya. Nama database aplikasi jangan berakhiran _test.
# DB di host yang sama dengan Docker: pakai host.docker.internal + extra_hosts "host.docker.internal:host-gateway".
DATABASE_URL=mysql+asyncmy://ronda_app:GANTI_PASSWORD@db.example.internal:3306/ronda
# Worker butuh hak ALTER/DROP (partisi metrik & audit); wajib diisi untuk docker compose.
WORKER_DATABASE_URL=mysql+asyncmy://ronda_worker:GANTI_PASSWORD@db.example.internal:3306/ronda

# Wajib ≥ 32 karakter (aplikasi menolak start bila kurang):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Subnet network docker compose; juga satu-satunya sumber X-Forwarded-For yang dipercaya uvicorn.
# Ganti hanya bila bentrok dengan network lain di host.
APP_SUBNET=172.30.0.0/24

WEB_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# argon2 paralel per proses web; tiap hash ±64 MiB RAM
PASSWORD_HASH_CONCURRENCY=4

# Zona waktu tampilan (filter `localtime`); data di DB tetap UTC
DISPLAY_TIMEZONE=Asia/Jakarta

ORG_NAME=RS Contoh
HOME_PATH=/dashboard
# Session login: idle 30 menit, maksimal 12 jam sejak login
SESSION_TTL=1800
SESSION_MAX_AGE=43200

# Volume data (docker-compose: ronda-data)
SCREENSHOT_DIR=/srv/data/screenshots
RELEASE_DIR=/srv/data/releases

# Notifikasi alert (kosong = kanal jenis itu tidak mengirim)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_USER=
WHATSAPP_API_PASSWORD=

# Worker (addon jobs)
WORKER_CONCURRENCY=10
WORKER_SHUTDOWN_GRACE=25
WORKER_WATCHDOG_TIMEOUT=120
