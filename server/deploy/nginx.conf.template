# Template: image nginx mengisi variabel TRUSTED_PROXY dari environment saat start (envsubst, hanya variabel itu:
# NGINX_ENVSUBST_FILTER di docker-compose.yml), hasilnya /etc/nginx/conf.d/default.conf.
#
# Rate limit login di proxy (lapis pertama); tabel login_failures di app adalah lapis kedua.
# Hanya POST yang dibatasi (key kosong = tidak dihitung): membuka halaman login tidak memakan jatah.
# Batas per IP: satu kantor di balik NAT berbagi jatah ini, jadi jangan terlalu ketat.
map $request_method $login_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $login_limit_key zone=login:10m rate=30r/m;
# Pendaftaran agent: key bersama bisa ditebak-tebak; batasi per IP
limit_req_zone $binary_remote_addr zone=enroll:10m rate=10r/m;
# Endpoint mahal untuk user (ekspor laporan/CSV)
limit_req_zone $binary_remote_addr zone=export:10m rate=20r/m;

# URL dari static_url() membawa ?v=<hash isi file>: isi berubah = URL berubah, jadi aman di-cache selamanya.
# Tanpa ?v= (mis. favicon, gambar dari CSS) cukup 1 jam.
map $arg_v $static_expires {
    ""      1h;
    default max;
}

# TLS diterminasi reverse proxy di depan (Nginx Proxy Manager). Hanya request dari TRUSTED_PROXY (.env) yang
# boleh menentukan IP asli user (X-Forwarded-For) dan skema https (X-Forwarded-Proto); dari IP lain header itu
# diabaikan, jadi client yang langsung ke port ini tidak bisa memalsukan IP untuk lolos rate limit login.
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${TRUSTED_PROXY} 1;
}
map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    default   $scheme;
    "1:https" https;
    "1:http"  http;
}

upstream app {
    server web:8000;
    keepalive 32;
    # WAJIB < --timeout-keep-alive uvicorn (75 s di Dockerfile). Bila nginx menyimpan koneksi idle lebih lama
    # dari uvicorn, nginx kadang memakai koneksi yang baru ditutup uvicorn → 502; POST tidak dicoba ulang.
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_tokens off;
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # $remote_addr = IP asli user (dari X-Forwarded-For milik proxy tepercaya). Tanpa ini $remote_addr adalah IP
    # proxy: limit_req dan lockout per-IP di app berlaku untuk SEMUA user sekaligus. recursive: entri paling kanan
    # yang bukan proxy tepercaya, jadi entri palsu yang ditambahkan client di kiri tidak dipakai.
    set_real_ip_from ${TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    proxy_set_header Host $host;
    # TIMPA, jangan tambah ($proxy_add_x_forwarded_for): header X-Forwarded-For kiriman client tidak boleh
    # sampai ke app, karena dipakai sebagai IP untuk rate limit login (references/deployment.md §1).
    proxy_set_header X-Forwarded-For $remote_addr;
    # https bila datang lewat proxy TLS: server_url di halaman Pendaftaran Agent ikut https
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    # Request ID dibuat nginx, bukan diteruskan dari client: ID palsu tidak bisa mengacaukan penelusuran log
    # (ID ikut ke log app dan ke jobs.request_id). Ada LB di depan yang membuat ID sendiri? Teruskan header LB itu.
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 30s;

    # HSTS dipasang di proxy TLS (NPM: tab SSL → HSTS Enabled), bukan di sini (port ini HTTP biasa).

    location /static/ {
        alias /srv/static/;
        expires $static_expires;
        access_log off;
    }

    # Health check bukan untuk publik: /readyz membuka koneksi DB baru tiap panggilan. Healthcheck compose
    # memanggil container langsung (bukan lewat nginx). LB di depan nginx yang memakai /readyz: allow IP-nya.
    location ~ ^/(healthz|readyz)$ {
        # allow <IP/subnet proxy>;   (bila proxy memakai /readyz sebagai health check)
        allow 127.0.0.1;
        deny all;
        proxy_pass http://app;
    }

    location = /login {
        limit_req zone=login burst=20 nodelay;   # menampung login serentak pagi hari dari satu NAT
        limit_req_status 429;
        proxy_pass http://app;
    }

    location = /api/agent/enroll {
        limit_req zone=enroll burst=20 nodelay;   # GPO memasang banyak PC sekaligus
        limit_req_status 429;
        proxy_pass http://app;
    }

    location /api/agent/screenshots/ {
        client_max_body_size 4m;                  # SCREENSHOT_MAX_BYTES 3 MB
        proxy_pass http://app;
    }

    location = /agents/releases {
        client_max_body_size 210m;                # unggah paket agent (RELEASE_MAX_BYTES 200 MB)
        proxy_read_timeout 300s;
        proxy_pass http://app;
    }

    location ~ ^/(reports/(download|print)|audit/export\.csv|alerts/export\.csv) {
        limit_req zone=export burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://app;
    }

    # WebSocket agent (/ws/agent) belum dipakai: perintah dikirim lewat respons heartbeat.

    location / {
        proxy_pass http://app;
    }
}
